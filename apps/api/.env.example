# ---- Messaging (email, SMS, push, reminders). Admin can override most of these in Messaging → Messaging settings ----
# Email: customers sign in by phone, so email only goes to shoppers who added one. Use smtp (or log in dev).
# Set MAIL_FROM_ADDRESS to orders@<your domain> and MAIL_REPLY_TO_ADDRESS to support@<your domain>.
# SMTP examples (MAIL_MAILER=smtp, MAIL_SCHEME=smtp for STARTTLS on 587, smtps for 465):
#   Amazon SES SMTP: MAIL_HOST=email-smtp.ap-south-1.amazonaws.com MAIL_PORT=587, SMTP credentials from the SES console (not IAM keys)
#   Brevo:           MAIL_HOST=smtp-relay.brevo.com MAIL_PORT=587, login + SMTP key from Brevo → SMTP & API
#   Mailgun:         MAIL_HOST=smtp.mailgun.org MAIL_PORT=587, MAIL_USERNAME=postmaster@mg.<domain>
#   Zoho Mail:       MAIL_HOST=smtp.zoho.com MAIL_PORT=465 MAIL_SCHEME=smtps (smtppro.zoho.com for paid org accounts)
MAIL_REPLY_TO_ADDRESS=
MAIL_REPLY_TO_NAME=
MAIL_LOGO_URL=
ALERT_EMAIL=
SUPPORT_PHONE=
SUPPORT_ADDRESS=
# SMS: SMS_DRIVER = log | bulksmsbd | sslwireless | alpha | http (legacy). SMS_FAILOVER = ordered list, e.g. bulksmsbd,sslwireless
# OTP_DRIVER picks the first gateway for OTP codes (log in dev shows demoCode).
SMS_FAILOVER=
SMS_PER_PHONE_PER_HOUR=
SMS_COST_PER_SEGMENT=
SMS_LOW_BALANCE=
BULKSMSBD_URL=
BULKSMSBD_API_KEY=
BULKSMSBD_SENDER_ID=
SSLWIRELESS_URL=
SSLWIRELESS_API_TOKEN=
SSLWIRELESS_SID=
ALPHA_SMS_URL=
ALPHA_SMS_API_KEY=
ALPHA_SMS_SENDER_ID=
# Push: Expo push service (mobile). EXPO_ACCESS_TOKEN only if "enhanced push security" is on in Expo.
EXPO_PUSH_URL=
EXPO_ACCESS_TOKEN=
# Web Push (VAPID) needs minishlink/web-push, not installed yet: subscriptions are stored, delivery is a TODO.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Queues (all default to "default"; OTP is sent synchronously). For priority: MESSAGING_QUEUE=notifications,
# MESSAGING_QUEUE_MARKETING=marketing and run `php artisan queue:work --queue=notifications,default,marketing`
MESSAGING_QUEUE=
MESSAGING_QUEUE_OTP=
MESSAGING_QUEUE_MARKETING=

# AI shopping assistant (Claude API). Without a key the assistant runs in basic search mode.
ANTHROPIC_API_KEY=
ASSISTANT_MONTHLY_BUDGET_USD=50
# Shared with the Next.js server (web INTERNAL_API_KEY) so the API trusts its forwarded shopper IP.
INTERNAL_API_KEY=

# ---- Security (docs/SECURITY.md) ----
INTERNAL_API_KEY=
# Signed app clients: id:secret[,id2:secret2] (mobile EXPO_PUBLIC_APP_KEY / EXPO_PUBLIC_APP_SECRET)
APP_SIGNING_KEYS=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
ADMIN_REQUIRE_2FA=true
ADMIN_IP_ALLOWLIST=
ADMIN_SESSION_TIMEOUT=60
TRUST_CF_CONNECTING_IP=false
# SECURITY_ENFORCE=true   (default; false only in phpunit)
QR_ALLOWED_HOSTS=

# ---- Finance / fraud ----
FX_PAID_INR_BDT=0
USD_BDT=122
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
# Fraud check: courier delivery history. Each turns on once its login is set (here or in Admin → Finance & security).
PATHAO_USERNAME=
PATHAO_PASSWORD=
REDX_FRAUD_ENABLED=false
CARRYBEE_PHONE=
CARRYBEE_PASSWORD=
